# ===========================================
# GitHub OAuth Configuration (Optional)
# ===========================================
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Note: Requires 'repo' scope which grants access to all repositories

# Client ID from your GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id

# Client Secret from your GitHub OAuth App (only needed for serverless function)
GITHUB_CLIENT_SECRET=your_github_client_secret

# ===========================================
# Google OAuth Configuration (Recommended)
# ===========================================
# Create a Google OAuth App at: https://console.cloud.google.com/apis/credentials
# Required scopes: drive.file, userinfo.profile, userinfo.email
# Note: drive.file only accesses files created by this app (better privacy)

# Client ID from your Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id

# Client Secret from your Google OAuth credentials (only needed for serverless function)
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===========================================
# Common Configuration
# ===========================================
# Allowed origin for CORS (your production domain)
ALLOWED_ORIGIN=https://your-app.netlify.app

# ===========================================
# Frontend Environment Variables (VITE_ prefix for Vite)
# ===========================================

# GitHub OAuth (optional)
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/
VITE_TOKEN_EXCHANGE_URL=/.netlify/functions/oauth

# Google OAuth (recommended)
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/
VITE_GOOGLE_TOKEN_EXCHANGE_URL=/.netlify/functions/google-oauth

# ===========================================
# Analytics (Optional)
# ===========================================
# Get your Measurement ID from Google Analytics:
# https://analytics.google.com/ → Admin → Data Streams → Your stream → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
