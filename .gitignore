# Python lib directories (not packages/web/src/lib)
/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# Logs
logs/

# User data directory (users should use their own private repo for data sync)
data/

# Keep web/dist committed so the web UI works out of the box
# To rebuild: cd web && npm install && npm run build

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.log
*.tmp

#web files
web/.bin/*

# Node.js / pnpm monorepo
node_modules/
packages/*/node_modules/
functions/*/node_modules/
packages/core/dist/
packages/storage/dist/
packages/sync/dist/
*.tsbuildinfo

# Keep web dist for easy deployment
# packages/web/dist/

# Prevent npm lock files (use pnpm)
package-lock.json
**/package-lock.json

# Function build artifacts (Netlify builds these)
functions/*/*.js
functions/*/dist/
