[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "taskman"
version = "0.1.0"
description = "Smart Task Manager with Auto-Scheduling, Web UI, and Multi-Device Sync"
readme = "README.md"
license = {text = "MIT"}
requires-python = ">=3.11"
authors = [
    {name = "TaskMan Team"}
]
keywords = ["task", "manager", "scheduler", "productivity", "habits"]
classifiers = [
    "Development Status :: 4 - Beta",
    "Environment :: Console",
    "Environment :: Web Environment",
    "Framework :: FastAPI",
    "Intended Audience :: End Users/Desktop",
    "License :: OSI Approved :: MIT License",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Topic :: Office/Business :: Scheduling",
]
dependencies = [
    "fastapi>=0.104.0",
    "uvicorn[standard]>=0.24.0",
    "pydantic>=2.4.0",
    "click>=8.1.0",
    "rich>=13.6.0",
    "textual>=0.40.0",
    "requests>=2.31.0",
    "python-dateutil>=2.8.2",
    "pyyaml>=6.0.1",
    "schedule>=1.2.0",
    "websockets>=12.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
    "pytest-asyncio>=0.21.0",
    "httpx>=0.25.0",
]

[project.scripts]
task = "taskman.client.cli:cli"
task-server = "taskman.server.main:start_server"

[project.urls]
Homepage = "https://github.com/RajeshDM/task_manager"
Repository = "https://github.com/RajeshDM/task_manager"
Issues = "https://github.com/RajeshDM/task_manager/issues"

[tool.setuptools.packages.find]
where = ["."]
include = ["taskman*"]

[tool.setuptools.package-data]
"*" = ["*.json", "*.yaml", "*.yml"]
